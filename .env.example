# Copie este arquivo para .env e preencha apenas os providers que deseja usar.
# A conta administradora é sempre AG000001. Nunca coloque uma senha real no código.
SOFIA_ADMIN_EMAIL=seu-email-administrativo@exemplo.local
SOFIA_ADMIN_FIRST_PASSWORD=
# Use true uma única vez se a base data/sofia.sqlite3 já tiver um admin de desenvolvimento.
SOFIA_ADMIN_RESET_PASSWORD=false
SOFIA_SESSION_SECRET=
SOFIA_ADMIN_TOTP_SECRET=
SOFIA_OCR_LANG=por+eng

# Privacidade: providers externos ficam bloqueados por padrão. Ollama é local.
SOFIA_ALLOW_EXTERNAL_DATA=false
SOFIA_ALLOW_EXTERNAL_CLINICAL=false
SOFIA_AUDIT_RETENTION_DAYS=365

# Produção deve falhar fechado sem PostgreSQL. Em desenvolvimento, o SQLite
# local é permitido somente para trabalhar offline.
SOFIA_STORAGE_MODE=developer
SOFIA_ENCRYPTION_KEY=
SOFIA_APP_VERSION=local
SOFIA_PROMPT_VERSION=1.0

# Após upload ou ingestão de link, atualiza o modelo neural do módulo em background.
SOFIA_AUTO_TRAIN=true
SOFIA_AUTO_TRAIN_EPOCHS=24
# Na inicialização, enfileira módulos desatualizados um por vez.
SOFIA_AUTO_TRAIN_ON_STARTUP=true
# Atualiza em background os domínios que o administrador já cadastrou.
SOFIA_AUTO_REFRESH_LINKS=true
SOFIA_LINK_REFRESH_HOURS=24
SOFIA_LINK_REFRESH_INTERVAL_SECONDS=3600

# Expansão contínua: fila persistente de temas e fontes públicas autorizadas.
# O ciclo é horário, limitado e retomável após reinício. O admin pode pausar
# ou executar por módulo no painel Dashboard.
SOFIA_AUTO_EXPANSION=true
SOFIA_EXPANSION_AUDIT_ON_STARTUP=true
SOFIA_EXPANSION_INTERVAL_SECONDS=3600
SOFIA_EXPANSION_MAX_PAGES_PER_TOPIC=10
SOFIA_EXPANSION_MAX_TOPICS_PER_CYCLE=5
SOFIA_EXPANSION_MIN_REFRESH_HOURS=24
SOFIA_EXPANSION_MAX_ATTEMPTS=3
SOFIA_EXPANSION_TIMEOUT_SECONDS=30
SOFIA_EXPANSION_CONCURRENCY=1
SOFIA_EXPANSION_MAX_PAGE_CHARS=250000
SOFIA_EXPANSION_MAX_DEPTH=2
SOFIA_EXPANSION_SEARCH_PROVIDERS=duckduckgo
SOFIA_EXPANSION_MAX_STORAGE_MB_PER_MODULE=2048
SOFIA_EXPANSION_RELEVANCE_THRESHOLD=2
SOFIA_EXPANSION_STORE_USER=false
SOFIA_EXPANSION_PAUSED=false
SOFIA_RESPECT_ROBOTS=true
SOFIA_PROVIDER_TIMEOUT_SECONDS=25
# Tempo máximo do resumo; o primeiro carregamento de um modelo local pode ser lento.
SOFIA_CONCISE_TIMEOUT_SECONDS=18
# Tempo máximo da resposta estruturada, que organiza conclusão, evidências e limites.
SOFIA_STRUCTURED_TIMEOUT_SECONDS=24

# Opcional: quando preenchido, os links ingeridos são registrados neste PostgreSQL.
# Exemplo: postgresql://usuario:senha@localhost:5432/sofia
SOFIA_POSTGRES_URL=

# Embeddings neurais locais. O modelo conversacional e o embedding são separados.
SOFIA_EMBEDDINGS_ENABLED=true
SOFIA_EMBEDDINGS_QUERY_ENABLED=true
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
SOFIA_EMBEDDING_MAX_CHUNKS=20000
SOFIA_EMBEDDING_BATCH_SIZE=32
SOFIA_EMBEDDING_TIMEOUT_SECONDS=120
SOFIA_EMBEDDING_QUERY_TIMEOUT_SECONDS=3

# Integração institucional somente leitura (opcional; sem dados fictícios).
SOFIA_TASY_BASE_URL=
SOFIA_TASY_TOKEN=
SOFIA_TASY_TIMEOUT_SECONDS=15
SOFIA_TASY_PAGE_SIZE=100

# OpenAI Responses API: mantenha a chave somente no .env local do servidor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Por privacidade, o padrão é false. true replica o store:true do exemplo enviado.
OPENAI_STORE_RESPONSES=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_PREDICT=256

# Modelo Qwen 9B opcional, local e experimental (não é o padrão para saúde/direito).
# O quantizado Q4_K_M ocupa cerca de 5,78 GB e exige memória disponível.
# OLLAMA_MODEL=hf.co/ge525/Qwen3.8-9B-Distill-uncensored-heretic-Q4_K_M-GGUF:Q4_K_M

# Deixe vazio para cada computador usar o mesmo endereço do frontend na porta 8787.
VITE_API_URL=
