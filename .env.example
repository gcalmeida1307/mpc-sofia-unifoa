# Core AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
OLLAMA_BASE_URL=http://sofia_ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=
OLLAMA_API_KEY=
OLLAMA_MODE=native
REQUEST_TIMEOUT=240

# Security (recommended for production)
SECURITY_ADMIN_API_KEY=change-this-admin-key
# Generate with: python -c "import pyotp; print(pyotp.random_base32())"
SECURITY_MFA_TOTP_SECRET=
# Token inicial entregue ao admin somente em uma instalação nova
AUTH_BOOTSTRAP_TOKEN=
REQUEST_RATE_LIMIT_PER_MINUTE=120

# Snapshot and metrics
SNAPSHOT_INTERVAL_SECONDS=30
AI_METRICS_WINDOW_HOURS=24

# PostgreSQL hardening
POSTGRES_DB=sofia
POSTGRES_USER=sofia
POSTGRES_PASSWORD=change-this-strong-password

# Integrations
ZABBIX_URL=
ZABBIX_USER=
ZABBIX_PASSWORD=

# Observability integrations
GRAFANA_URL=http://sofia_grafana:3000
GRAFANA_TOKEN=
GRAFANA_ADMIN_USER=sofiaadmin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_POSTGRES_PASSWORD=
